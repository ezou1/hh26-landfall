# Copy this file to .env and set the values. Do not commit .env.
# Cesium ion token for Google Photorealistic 3D Tiles. Empty = Esri imagery fallback.
CESIUM_ION_TOKEN=
# Chalk mode: "local" runs the resolvers in-process; "remote" uses the Chalk deployment.
CHALK_MODE=local
CHALK_CLIENT_ID=
CHALK_CLIENT_SECRET=
CHALK_ENVIRONMENT=
# Seed for every Monte Carlo stage.
LANDFALL_SEED=42
# Optional. Without a key, the census data comes from the keyless ACS summary files.
CENSUS_API_KEY=
